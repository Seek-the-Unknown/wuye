<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.property.mapper.PmsBuildingMapper">
    <resultMap type="PmsBuilding" id="PmsBuildingResult">
        <result property="buildingId"    column="building_id"    />
        <result property="communityId"   column="community_id"   />
        <result property="buildingName"  column="building_name"  />
        <result property="buildingCode"  column="building_code"  />
        <result property="floors"        column="floors"         />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
        <result property="communityName" column="community_name" />
    </resultMap>

    <sql id="selectPmsBuildingVo">
        select b.building_id, b.community_id, b.building_name, b.building_code, b.floors, b.status, b.del_flag,
               b.create_by, b.create_time, b.update_by, b.update_time, b.remark, c.community_name
        from pms_building b
        left join pms_community c on b.community_id = c.community_id
    </sql>

    <select id="selectPmsBuildingList" parameterType="PmsBuilding" resultMap="PmsBuildingResult">
        <include refid="selectPmsBuildingVo"/>
        <where>  
            b.del_flag = '0'
            <if test="communityId != null">and b.community_id = #{communityId}</if>
            <if test="buildingName != null  and buildingName != ''"> and b.building_name like concat('%', #{buildingName}, '%')</if>
            <if test="buildingCode != null  and buildingCode != ''"> and b.building_code like concat('%', #{buildingCode}, '%')</if>
            <if test="status != null and status != ''">and b.status = #{status}</if>
        </where>
    </select>
    
    <select id="selectPmsBuildingByBuildingId" parameterType="Long" resultMap="PmsBuildingResult">
        <include refid="selectPmsBuildingVo"/>
        where b.building_id = #{buildingId} and b.del_flag = '0'
    </select>
        
    <insert id="insertPmsBuilding" parameterType="PmsBuilding" useGeneratedKeys="true" keyProperty="buildingId">
        insert into pms_building
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="communityId != null">community_id,</if>
            <if test="buildingName != null and buildingName != ''">building_name,</if>
            <if test="buildingCode != null and buildingCode != ''">building_code,</if>
            <if test="floors != null">floors,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="communityId != null">#{communityId},</if>
            <if test="buildingName != null and buildingName != ''">#{buildingName},</if>
            <if test="buildingCode != null and buildingCode != ''">#{buildingCode},</if>
            <if test="floors != null">#{floors},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePmsBuilding" parameterType="PmsBuilding">
        update pms_building
        <trim prefix="SET" suffixOverrides=",">
            <if test="communityId != null">community_id = #{communityId},</if>
            <if test="buildingName != null and buildingName != ''">building_name = #{buildingName},</if>
            <if test="buildingCode != null and buildingCode != ''">building_code = #{buildingCode},</if>
            <if test="floors != null">floors = #{floors},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where building_id = #{buildingId}
    </update>

    <delete id="deletePmsBuildingByBuildingId" parameterType="Long">
        update pms_building set del_flag = '2' where building_id = #{buildingId}
    </delete>

    <delete id="deletePmsBuildingByBuildingIds" parameterType="String">
        update pms_building set del_flag = '2' where building_id in 
        <foreach item="buildingId" collection="array" open="(" separator="," close=")">
            #{buildingId}
        </foreach>
    </delete>
</mapper>
