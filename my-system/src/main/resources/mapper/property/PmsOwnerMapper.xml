<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.property.mapper.PmsOwnerMapper">
    
    <resultMap type="PmsOwner" id="PmsOwnerResult">
        <result property="ownerId"    column="owner_id"    />
        <result property="ownerName"  column="owner_name"  />
        <result property="phone"      column="phone"       />
        <result property="idCard"     column="id_card"     />
        <result property="gender"     column="gender"      />
        <result property="status"     column="status"      />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectPmsOwnerVo">
        select owner_id, owner_name, phone, id_card, gender, status, del_flag, create_by, create_time, update_by, update_time, remark from pms_owner
    </sql>

    <select id="selectPmsOwnerList" parameterType="PmsOwner" resultMap="PmsOwnerResult">
        <include refid="selectPmsOwnerVo"/>
        <where>  
            del_flag = '0'
            <if test="ownerName != null  and ownerName != ''"> and owner_name like concat('%', #{ownerName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectPmsOwnerByOwnerId" parameterType="Long" resultMap="PmsOwnerResult">
        <include refid="selectPmsOwnerVo"/>
        where owner_id = #{ownerId} and del_flag = '0'
    </select>
        
    <insert id="insertPmsOwner" parameterType="PmsOwner" useGeneratedKeys="true" keyProperty="ownerId">
        insert into pms_owner
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ownerName != null and ownerName != ''">owner_name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="idCard != null">id_card,</if>
            <if test="gender != null">gender,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ownerName != null and ownerName != ''">#{ownerName},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="gender != null">#{gender},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePmsOwner" parameterType="PmsOwner">
        update pms_owner
        <trim prefix="SET" suffixOverrides=",">
            <if test="ownerName != null and ownerName != ''">owner_name = #{ownerName},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where owner_id = #{ownerId}
    </update>

    <delete id="deletePmsOwnerByOwnerId" parameterType="Long">
        update pms_owner set del_flag = '2' where owner_id = #{ownerId}
    </delete>

    <delete id="deletePmsOwnerByOwnerIds" parameterType="String">
        update pms_owner set del_flag = '2' where owner_id in 
        <foreach item="ownerId" collection="array" open="(" separator="," close=")">
            #{ownerId}
        </foreach>
    </delete>
</mapper>
