<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.property.mapper.PmsParkingMapper">

    <resultMap type="PmsParking" id="PmsParkingResult">
        <result property="parkingId"     column="parking_id"     />
        <result property="communityId"   column="community_id"   />
        <result property="parkingCode"   column="parking_code"   />
        <result property="parkingType"   column="parking_type"   />
        <result property="ownerId"       column="owner_id"       />
        <result property="plateNumber"   column="plate_number"   />
        <result property="bindStatus"    column="bind_status"    />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
        <result property="communityName" column="community_name" />
        <result property="ownerName"     column="owner_name"     />
    </resultMap>

    <sql id="selectPmsParkingVo">
        select p.parking_id, p.community_id, p.parking_code, p.parking_type, p.owner_id,
               p.plate_number, p.bind_status, p.status, p.del_flag,
               p.create_by, p.create_time, p.update_by, p.update_time, p.remark,
               c.community_name, o.owner_name
        from pms_parking p
        left join pms_community c on p.community_id = c.community_id
        left join pms_owner o on p.owner_id = o.owner_id
    </sql>

    <select id="selectPmsParkingList" parameterType="PmsParking" resultMap="PmsParkingResult">
        <include refid="selectPmsParkingVo"/>
        <where>
            and p.del_flag = '0'
            <if test="communityId != null">and p.community_id = #{communityId}</if>
            <if test="parkingCode != null and parkingCode != ''">and p.parking_code like concat('%', #{parkingCode}, '%')</if>
            <if test="parkingType != null and parkingType != ''">and p.parking_type = #{parkingType}</if>
            <if test="bindStatus != null and bindStatus != ''">and p.bind_status = #{bindStatus}</if>
            <if test="plateNumber != null and plateNumber != ''">and p.plate_number like concat('%', #{plateNumber}, '%')</if>
        </where>
        order by p.community_id, p.parking_code
    </select>

    <select id="selectPmsParkingByParkingId" parameterType="Long" resultMap="PmsParkingResult">
        <include refid="selectPmsParkingVo"/>
        where p.parking_id = #{parkingId}
    </select>

    <select id="selectPmsParkingByPlateNumber" parameterType="String" resultMap="PmsParkingResult">
        <include refid="selectPmsParkingVo"/>
        where p.plate_number = #{plateNumber} and p.del_flag = '0'
        limit 1
    </select>

    <insert id="insertPmsParking" parameterType="PmsParking" useGeneratedKeys="true" keyProperty="parkingId">
        insert into pms_parking
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="communityId != null">community_id,</if>
            <if test="parkingCode != null and parkingCode != ''">parking_code,</if>
            <if test="parkingType != null">parking_type,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="plateNumber != null">plate_number,</if>
            <if test="bindStatus != null">bind_status,</if>
            <if test="status != null">status,</if>
            del_flag, create_by, create_time,
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="communityId != null">#{communityId},</if>
            <if test="parkingCode != null and parkingCode != ''">#{parkingCode},</if>
            <if test="parkingType != null">#{parkingType},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="plateNumber != null">#{plateNumber},</if>
            <if test="bindStatus != null">#{bindStatus},</if>
            <if test="status != null">#{status},</if>
            '0', #{createBy}, #{createTime},
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePmsParking" parameterType="PmsParking">
        update pms_parking
        <trim prefix="SET" suffixOverrides=",">
            <if test="communityId != null">community_id = #{communityId},</if>
            <if test="parkingCode != null and parkingCode != ''">parking_code = #{parkingCode},</if>
            <if test="parkingType != null">parking_type = #{parkingType},</if>
            owner_id = #{ownerId},
            <if test="plateNumber != null">plate_number = #{plateNumber},</if>
            <if test="bindStatus != null">bind_status = #{bindStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where parking_id = #{parkingId}
    </update>

    <delete id="deletePmsParkingByParkingId" parameterType="Long">
        update pms_parking set del_flag = '2' where parking_id = #{parkingId}
    </delete>

    <delete id="deletePmsParkingByParkingIds" parameterType="String">
        update pms_parking set del_flag = '2' where parking_id in
        <foreach item="parkingId" collection="array" open="(" separator="," close=")">
            #{parkingId}
        </foreach>
    </delete>
</mapper>
